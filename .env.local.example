# Copy this file to .env.local and fill in the values from your Supabase project.
#
# Where to find them:
#   Supabase dashboard → your project → Settings → API Keys
#
# WHICH KEY: use the PUBLISHABLE key (starts with sb_publishable_).
# On older projects this is called the "anon" key and lives under the
# "Legacy API Keys" tab — either works, but legacy keys are being retired at
# the end of 2026, so prefer the publishable one on a new project.
#
# .env.local must stay out of git. create-next-app gitignores it by default —
# confirm before your first commit.

NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# NEVER put the SECRET key (sb_secret_...) or the legacy service_role key in
# a NEXT_PUBLIC_ variable. Anything prefixed NEXT_PUBLIC_ is shipped to the
# browser, and those keys bypass every Row Level Security policy you wrote.
#
# These three are server-only (no NEXT_PUBLIC_ prefix, so Next.js never sends
# them to the browser) — needed for the Stripe webhook to mark someone's
# account as paid. Set them in your hosting provider's environment settings
# for production; only put real values here for local testing.

# Supabase → Project Settings → API Keys → Secret key (or legacy service_role).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API Keys → Secret key.
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → your endpoint → Signing secret.
# Only exists once you've created the webhook endpoint (see supabase/README
# or ask your assistant for the exact steps).
STRIPE_WEBHOOK_SECRET=

# Resend → API Keys. Create a NEW key rather than reusing the production one:
# Vercel stores it as a Secret, which cannot be revealed again after saving.
#
# The key MUST be scoped to recruitgrid.app or granted full access. A key
# scoped to a different domain returns 400 on every send, with a message that
# doesn't obviously name scoping as the cause.
#
# Sends the camp reminders, the weekly newsletter, and the post-payment
# confirmation in lib/emails/.
RESEND_API_KEY=

# Shared secret for the Vercel Cron endpoints under app/api/cron/. Any random
# string; it just has to match the value in your hosting environment. The cron
# routes fail closed when it is unset, so leaving it blank here means they
# return 401 rather than running unprotected.
CRON_SECRET=

# Where the daily signup digest and other operational mail is sent.
ADMIN_EMAIL=

# Optional. Film upload ceiling shown in the UI; defaults in code if unset.
# Matches the Supabase storage bucket limit set in 17-film-bucket-2gb.sql.
NEXT_PUBLIC_MAX_FILM_UPLOAD_MB=2048

# Web push (VAPID). Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The PUBLIC key ships to the browser on purpose — subscribing requires it, and
# it is not a secret. The PRIVATE key is server-only.
#
# Rotating the private key invalidates every existing subscription silently:
# sends start failing and nobody gets a notification again until they re-enable
# them. Generate these once and leave them alone.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address the push services see, as mailto:. Defaults to
# info@recruitgrid.app in lib/push.js if unset.
VAPID_SUBJECT=
